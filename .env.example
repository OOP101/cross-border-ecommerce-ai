# ============ 国际贸易上市公司一站式智能服务平台 环境配置示例 ============
# 复制本文件为 .env 并填写真实值

# ---- 应用 ----
APP_NAME=国际贸易上市公司一站式智能服务平台
APP_VERSION=0.2.0
DEBUG=true
API_PREFIX=/api/v1

# ---- 大语言模型 ----
# mock: 离线演示占位；openai_compatible: 通义千问/DeepSeek/OpenAI 等兼容接口
# 项目默认已切换为 DeepSeek（backend/.env 已配置真实 Key，此处仅作模板）
LLM_PROVIDER=openai_compatible
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
# deepseek-v4-pro（旗舰首选）/ deepseek-v4-flash（均衡性价比首选）
LLM_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
# 故障转移备用端点:分号分隔的 "base_url|api_key|model" 列表,主端点连接失败/超时/429/5xx/401 时自动切换
# 示例:LLM_FAILOVER=https://api.xiaomimimo.com/v1|sk-your-mimo-key|mimo-v2.5-pro
LLM_FAILOVER=

# ---- 嵌入模型 ----
# mock: 基于 n-gram 哈希的离线向量；openai_compatible: 真实嵌入接口
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=384

# ---- 向量库 ----
# memory: 内存向量库（开发）；chroma: Chroma 持久化（生产）
VECTOR_STORE=memory
CHROMA_PERSIST_DIR=./data/chroma

# ---- 数据库 ----
DATABASE_URL=sqlite:///./data/app.db

# ---- RAG 参数 ----
CHUNK_SIZE=500
CHUNK_OVERLAP=128
RAG_TOP_K=5
# 混合检索权重：0.4/0.6 为 Mock Embedding 下实测最优；接入真实 Embedding 后用 scripts/eval_rag.py 重调
HYBRID_WEIGHT_VECTOR=0.4
HYBRID_WEIGHT_BM25=0.6
ENABLE_RERANK=false
# 重排序实现：heuristic（默认零依赖）| cross_encoder（需安装 sentence-transformers，见 requirements-optional.txt）
RERANK_PROVIDER=heuristic
RERANK_MODEL=BAAI/bge-reranker-base

# ---- CORS ----
CORS_ORIGINS=["*"]

# ---- 鉴权（JWT）----
# 演示模式保持 false（管理后台免登录）；生产环境改为 true 启用 Bearer 令牌鉴权
AUTH_REQUIRED=false
# 生产务必替换为强随机值：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================
# 快速切换真实模型（通义千问 / DeepSeek / OpenAI 兼容）
# 仅改以下几行即可把 mock 换成真实大模型，无需改代码
# ============================================================
# 硅基流动 SiliconFlow（一个 Key 可用多家模型；模型 ID 以控制台为准）：
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=sk-your-siliconflow-key
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# 可选模型：DeepSeek V4-Pro / V4-Flash / V3.2 / R1；
#           Qwen3.6 / Qwen3.5；GLM-5.1 / GLM-4.7；Kimi-K2.6
#
# 通义千问（DashScope 兼容模式）：
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=sk-your-dashscope-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
#
# DeepSeek：
# LLM_API_KEY=sk-your-deepseek-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
#
# 真实嵌入（让 RAG 向量检索具备语义能力）：
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_API_KEY=sk-your-dashscope-key
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIM=1024
