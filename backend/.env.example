# ============ 国际贸易上市公司一站式智能服务平台 后端环境配置示例 ============
# 复制本文件为 .env 并填入实际值：cp .env.example .env
# 本文件已被 .gitignore 忽略，请勿提交到版本库

# ============ 大语言模型配置 ============
# 支持任何 OpenAI 兼容接口：DeepSeek、小米 MiMo、通义千问、OpenAI、Moonshot 等
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60

# 故障转移配置（可选）：格式为 "base_url|api_key|model"，多个用分号分隔
# 主端点失败时自动切换到备用端点
LLM_FAILOVER=

# ============ 嵌入模型配置 ============
# mock: 基于 n-gram 哈希的离线向量（开发测试用）
# openai_compatible: 真实嵌入接口（生产环境推荐）
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=384

# ============ 向量库配置 ============
# memory: 内存向量库（开发环境，重启后数据丢失）
# chroma: Chroma 持久化存储（生产环境推荐）
VECTOR_STORE=memory
CHROMA_PERSIST_DIR=./data/chroma

# ============ 数据库配置 ============
# SQLite（默认，适合开发和单机部署）
DATABASE_URL=sqlite:///./data/app.db

# PostgreSQL（生产环境推荐）
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# MySQL
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/dbname

# ============ RAG 检索参数 ============
CHUNK_SIZE=500
CHUNK_OVERLAP=128
RAG_TOP_K=5
HYBRID_WEIGHT_VECTOR=0.4
HYBRID_WEIGHT_BM25=0.6
ENABLE_RERANK=false

# ============ 跨域配置 ============
# 生产环境请指定具体域名，如：["http://localhost:5173", "https://yourdomain.com"]
CORS_ORIGINS=["*"]

# ============ 亚马逊 SP-API 配置 ============
# 在 Amazon Seller Central 注册开发者后获取以下凭证
# 详细文档：https://developer-docs.amazon.com/sp-api/docs/registering-as-a-developer

# LWA（Login with Amazon）凭证
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=

# AWS IAM 凭证（用于 Signature V4 签名）
AMAZON_AWS_ACCESS_KEY=
AMAZON_AWS_SECRET_KEY=
AMAZON_AWS_REGION=us-east-1
AMAZON_AWS_ROLE_ARN=

# 默认站点代码：US | UK | DE | FR | IT | ES | JP | AU | IN | CA
AMAZON_DEFAULT_MARKETPLACE=US

# OAuth 回调地址（需与 Seller Central 中配置的一致）
AMAZON_OAUTH_REDIRECT_URI=http://localhost:8009/api/v1/amazon/oauth/callback

# ============ 认证配置（可选） ============
# 设为 true 启用登录认证，false 为演示模式（免登录）
AUTH_REQUIRED=false

# JWT 配置
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ 服务端口配置 ============
# 注意：端口实际在 launcher.py 中配置，此处仅作记录
# BACKEND_PORT=8009
# FRONTEND_PORT=5174
