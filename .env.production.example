# ============ 生产环境配置模板 ============
# 复制为 .env.production 并填写真实值；务必逐项核对「必改」标记。

# ---- 应用 ----
DEBUG=false

# ---- 大语言模型 ----
LLM_PROVIDER=openai_compatible
LLM_API_KEY=sk-your-key-here                      # 必改：真实 Key，勿提交仓库
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro

# ---- 嵌入模型（生产建议真实嵌入，向量检索才有语义能力）----
EMBEDDING_PROVIDER=openai_compatible              # 必改
EMBEDDING_API_KEY=sk-your-key-here                # 必改
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ---- 向量库（生产用 Chroma 持久化）----
VECTOR_STORE=chroma                               # 必改
CHROMA_PERSIST_DIR=./data/chroma

# ---- 数据库（多实例部署前迁移 PostgreSQL）----
DATABASE_URL=sqlite:///./data/app.db              # 单机可保留；集群必改 postgresql://...

# ---- RAG 参数 ----
CHUNK_SIZE=500
CHUNK_OVERLAP=128
RAG_TOP_K=5
HYBRID_WEIGHT_VECTOR=0.6
HYBRID_WEIGHT_BM25=0.4
ENABLE_RERANK=false
RERANK_PROVIDER=heuristic                         # heuristic | cross_encoder（需 sentence-transformers）
RERANK_MODEL=BAAI/bge-reranker-base

# ---- 安全（全部必改）----
AUTH_REQUIRED=true                                # 必改：开启 Bearer 鉴权
JWT_SECRET_KEY=change-me-with-secrets-token-urlsafe-48   # 必改：python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["https://your-domain.com"]          # 必改：前端正式域名白名单

# 部署后立即修改默认管理员密码（admin/admin123），或用新管理员替换。
